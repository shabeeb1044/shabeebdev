{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "shabeebdev",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "shabeebdev"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://shabeebdev.online",
		"NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY": "a4eb4aee-4b85-4119-971a-b363650d4c2a"
	}
}
